// Konfigurasi Cloudflare Worker.
// JANGAN taruh rahasia di file ini. Rahasia diisi dengan `wrangler secret put NAMA`
// (staging/production) atau di file .dev.vars (lokal, tidak di-commit).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarpras-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Worker yang sama melayani frontend (hasil build apps/web) dan API (ADR-002).
  // Request /api/* selalu masuk ke kode Worker; sisanya dilayani sebagai file statis,
  // dan URL yang tidak dikenal dikembalikan ke index.html (routing di sisi React).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "local",
  },
  "env": {
    "staging": {
      "name": "sarpras-manager-staging",
      "vars": { "APP_ENV": "staging" },
    },
    "production": {
      "name": "sarpras-manager",
      "vars": { "APP_ENV": "production" },
    },
  },
}
